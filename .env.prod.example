# Copy to .env.prod and fill in. .env.prod is gitignored — never commit it.

# --- Postgres (also consumed by docker-compose variable substitution) ---
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus

# --- API auth: every route except /health requires Authorization: Bearer <this> ---
# Generate with: openssl rand -hex 32
ARGUS_API_TOKEN=

# --- GitLab ---
ARGUS_GITLAB_URL=https://gitlab.example.internal
ARGUS_GITLAB_TOKEN=
# If GitLab uses an internal CA, place it at ./certs/ca.pem and uncomment:
# ARGUS_GITLAB_CA_BUNDLE=/certs/ca.pem

# --- Embeddings (Ollama on the GPU VM) ---
ARGUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# ARGUS_EMBEDDING_MODEL=ollama/nomic-embed-text
# ARGUS_EMBEDDING_DIM=768

# --- Distiller LLM (rejection -> learning) ---
ARGUS_DISTILLER_MODEL=openai/claude-sonnet-4-6
ARGUS_DISTILLER_API_BASE=
ARGUS_DISTILLER_API_KEY=

# --- Optional: Langfuse trace export ---
# ARGUS_LANGFUSE_ENABLED=true
# ARGUS_LANGFUSE_HOST=
# ARGUS_LANGFUSE_PUBLIC_KEY=
# ARGUS_LANGFUSE_SECRET_KEY=

# --- Logging (rotating file lives on the argus_logs volume at /logs) ---
# ARGUS_LOG_LEVEL=INFO
